{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riff",
  "version": "0.1.0",
  "identifier": "com.baruk.riff",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "island",
        "url": "index.html",
        "title": "Riff",
        "width": 360,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "center": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Ajustes de Riff",
        "width": 460,
        "height": 400,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
